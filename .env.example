# Copy to .env.local (git-ignored) and fill in. Names only here; never commit values (protocol §48).
# Server-only variables. NEVER prefix any of these with NEXT_PUBLIC_.

# ---- Shared -------------------------------------------------------------
# local | test | dev | demo
CDF_ENVIRONMENT=local

# ---- apps/investigation-web --------------------------------------------
# Connection string for the NOINHERIT login role cdf_bff (can only SET ROLE authenticated).
# Hosted Supabase: use the transaction pooler (port 6543), user "cdf_bff.<project-ref>".
CDF_BFF_DATABASE_URL=
# supabase | local-dev   (local-dev refuses to run on Vercel or outside local/test)
CDF_IDENTITY_PROVIDER=local-dev
SUPABASE_URL=
SUPABASE_ANON_KEY=
# local-dev provider only: >=32 random characters, and the shared password for synthetic users
CDF_DEV_IDENTITY_SECRET=
CDF_DEV_PASSWORD=
CDF_SESSION_MAX_AGE_SECONDS=28800
CDF_SESSION_IDLE_SECONDS=1800
# HMAC salt for sign-in rate-limit keys. >=32 random characters.
CDF_RATE_LIMIT_SALT=

# ---- apps/whistleblowing-web -------------------------------------------
# Connection string for the NOINHERIT login role cdf_portal (can only SET ROLE anon).
CDF_PORTAL_DATABASE_URL=
# HMAC pepper for report secrets (PrototypeKeyProvider; future Alibaba KMS). >=32 random characters.
CDF_REPORT_SECRET_PEPPER=
# HMAC salt for rate-limit keys. >=32 random characters.
CDF_RATE_LIMIT_SALT=

# ---- Database administration (scripts only, never the apps) -------------
# Used by `pnpm db:reset` to apply migrations and set login-role passwords.
CDF_ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CDF_BFF_DB_PASSWORD=
CDF_PORTAL_DB_PASSWORD=
