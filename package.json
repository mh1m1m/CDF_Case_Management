{
  "name": "cdf-case-platform",
  "private": true,
  "description": "CDF Case Management & Investigation Platform: synthetic-data reference implementation",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r --filter ./apps/* build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --parallel typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project integration --project security",
    "test:security": "vitest run --project security",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=accessibility",
    "db:reset": "node scripts/db/reset.mjs",
    "db:policies": "node scripts/db/policy-snapshot.mjs",
    "sbom": "node scripts/sbom.mjs",
    "audit:deps": "pnpm audit --audit-level=high --prod"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.4.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
